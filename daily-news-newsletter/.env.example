# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Adresse qui reçoit la newsletter quotidienne
EMAIL_TO=

# Optionnel — adresse expéditrice (doit être sur un domaine vérifié dans Resend,
# sinon laisser la valeur par défaut onboarding@resend.dev pour les tests)
FROM_EMAIL=onboarding@resend.dev

# Optionnel — modèle Claude utilisé pour la synthèse
ANTHROPIC_MODEL=claude-sonnet-5
